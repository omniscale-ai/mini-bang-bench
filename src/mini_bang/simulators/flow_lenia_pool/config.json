{
  "id": "flow_lenia_pool",
  "version": "1",
  "description": "Bounded observations from external Flow Lenia simulations without source metadata",
  "factory": "mini_bang.simulators.flow_lenia_pool.factory:create_pool_macro",
  "response_builder": "mini_bang.simulators.flow_lenia_pool.factory:observation_response",
  "cli": "mini_bang.simulators.flow_lenia_pool.cli:register",
  "grouped_sampling_safe": true,
  "resources": {
    "cpu": "2",
    "memory": "8Gi",
    "ephemeral_storage": "16Gi",
    "timeout_seconds": 1800
  },
  "runtime_environment": [
    "MINI_BANG_FLOW_POOL_REF",
    "MINI_BANG_FLOW_OBSERVATION_MODE"
  ],
  "executable_fields": [
    "A",
    "P",
    "F",
    "Food",
    "rgb"
  ],
  "defaults": {}
}
